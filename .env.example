# ===== Futures Signal — salin file ini menjadi .env =====

# Kata sandi untuk membuka dasbor. WAJIB diisi bila server bisa diakses dari internet.
# (Kosong = tanpa login.) Tips: pakai kalimat acak yang panjang.
APP_PASSWORD=admin

# Port yang dipakai di mesin Anda (Docker: port di host).
APP_PORT=8080

# Docker: 0.0.0.0 = bisa diakses dari luar; 127.0.0.1 = hanya lewat reverse proxy (Caddy/Nginx) di mesin yang sama.
APP_BIND=0.0.0.0

# Hanya bila memakai HTTPS otomatis Caddy (docker compose --profile https ...): domain Anda.
# DOMAIN=signal.contoh.com

# Alamat WebSocket server sendiri (nilai awal saja; bisa diubah dari halaman Pengaturan).
# Tidak dipakai bila memilih sumber "Binance langsung".
DEFAULT_WS_URL=wss://trades.domainanda.com/ws

# Berapa hari login bertahan.
SESSION_DAYS=30

# true bila di belakang reverse proxy (Caddy/Nginx/Cloudflare).
TRUST_PROXY=true

# ---- Tanpa Docker (opsional) ----
# DATA_DIR=./data     # folder penyimpanan semua data
# HOST=0.0.0.0
# PORT=8080

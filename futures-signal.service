# systemd (VPS tanpa Docker). Salin ke /etc/systemd/system/futures-signal.service lalu:
#   sudo systemctl daemon-reload && sudo systemctl enable --now futures-signal
# Sesuaikan User dan path sesuai lokasi Anda.
[Unit]
Description=Futures Signal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=futures
WorkingDirectory=/opt/futures-signal
EnvironmentFile=-/opt/futures-signal/.env
Environment=DATA_DIR=/opt/futures-signal/data
ExecStart=/usr/bin/node /opt/futures-signal/futures-signal.cjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/futures-signal/data

[Install]
WantedBy=multi-user.target
